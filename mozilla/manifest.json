{
  "manifest_version": 3,
  "name": "Twitter Sensitive Media Loader",
  "description": "Add a button that load hidden sensitive medias of tweet below it using fxtwitter api. By @C33purr c:",
  "version": "1.0",
  "action": {
	"default_popup": "index.html"
  },
  "background": {
	"scripts": ["background.js"]
  },
  "browser_specific_settings": {
	"gecko": {
	  "id": "twitter_sensitive_media_loader@c33purr"
	}
  },
  "icons": {
	"16": "icons/icon_16px.png",
	"32": "icons/icon_32px.png",
	"48": "icons/icon_48px.png",
	"128": "icons/icon_128px.png"
  },
  "permissions": ["storage","activeTab","webRequest"],
  "host_permissions": [
	"*://api.fxtwitter.com/*" 
  ],
  "content_scripts": [
   {
     "matches": ["https://*.x.com/*"],
     "css": ["style.css"],
	 "js": ["content.js"]
   }
 ]
}